# Export GTK/Xft settings to X11/Xwayland apps
exec xsettingsd

# Make Qt/KDE apps use the GTK platform theme
exec dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME=gtk3

# Start Waybar
exec waybar
exec autotiling-rs

# Keep the Sway border visible on floating windows. Sway switches them to
# client-side decorations (csd), which draws no Sway border; this listener
# forces `border pixel 2` whenever a window becomes floating.
exec ~/.config/sway/floating-border.py

include /etc/sway/config.d/*
