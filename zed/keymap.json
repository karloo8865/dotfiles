[
  {
    "context": "Workspace",
    "bindings": {
      "f5": ["task::Spawn", { "task_name": "Run Current Python File" }],
      "ctrl-alt-r": ["task::Spawn", { "task_name": "r/rust" }],
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-t": "task::Rerun"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-t": "task::Rerun"
    }
  }
]

